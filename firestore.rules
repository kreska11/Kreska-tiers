rules_version = '2';

// Reguły bezpieczeństwa Kreska's tiers.
// Wklej całość w Firebase: Firestore Database -> Reguły (Rules) -> Opublikuj (Publish).
// Te reguły sprawdza serwer Google, więc nie da się ich obejść z przeglądarki.

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠ Konto właściciela: TWÓJ NICK MAŁYMI LITERAMI + @gracze.kreska-tiers.example.com
    // Musi się zgadzać z ownerNick w pliku config.js.
    function ownerEmail() {
      return 'kreska11@gracze.kreska-tiers.example.com';
    }

    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email == ownerEmail();
    }
    function isMod() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mod';
    }
    function isStaff() {
      return isOwner() || isMod();
    }
    function validNick(n) {
      return n is string && n.matches('^[A-Za-z0-9_]{3,16}$');
    }

    // Ranking: każdy może czytać, zmieniać tylko właściciel i moderatorzy.
    // Zapisywane są punkty – tier strona wylicza sama z progów w config.js.
    match /players/{id} {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['nick', 'points', 'region', 'updatedAt'])
        && request.resource.data.keys().hasAll(['nick', 'points', 'region', 'updatedAt'])
        && validNick(request.resource.data.nick)
        && id == request.resource.data.nick.lower()
        && request.resource.data.points is int
        && request.resource.data.points >= 0
        && request.resource.data.points <= 9999
        && request.resource.data.region in ['EU', 'NA', 'SA', 'AS', 'AU', 'ME', 'AF']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isStaff();
    }

    // Konta: każdy widzi tylko swoje, właściciel widzi wszystkie.
    // Przy rejestracji można założyć tylko zwykłe konto gracza, pod własnym nickiem.
    // Uprawnienia (role) może zmieniać wyłącznie właściciel.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'nickLower', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['nick', 'nickLower', 'role', 'createdAt'])
        && validNick(request.resource.data.nick)
        && request.resource.data.nickLower == request.resource.data.nick.lower()
        && request.auth.token.email == request.resource.data.nickLower + '@gracze.kreska-tiers.example.com'
        && request.resource.data.role == 'player'
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['player', 'mod'];
      allow delete: if isOwner();
    }

    // Wszystko inne jest zablokowane.
  }
}
